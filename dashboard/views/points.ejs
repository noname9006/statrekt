<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= guildInfo.guild_name || 'Server' %> - Points Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <!-- Navigation -->
        <nav class="sidebar">
            <div class="nav-header">
                <h2><%= guildInfo.guild_name || 'Server Analytics' %></h2>
                <p class="guild-id">ID: <%= guildInfo.guild_id || 'N/A' %></p>
            </div>
            <ul class="nav-menu">
                <li><a href="/">📊 Overview</a></li>
                <li><a href="/messages">💬 Messages</a></li>
                <li class="active"><a href="/points">⭐ Points</a></li>
                <li><a href="/settings">⚙️ Settings</a></li>
            </ul>
        </nav>

        <!-- Main Content -->
        <main class="main-content">
            <header class="content-header">
                <h1>Points Dashboard</h1>
                <div class="timeframe-selector">
                    <select id="timeframe" onchange="changeTimeframe(this.value)">
                        <option value="24h" <%= timeframe === '24h' ? 'selected' : '' %>>Last 24 Hours</option>
                        <option value="week" <%= timeframe === 'week' ? 'selected' : '' %>>Last 7 Days</option>
                        <option value="month" <%= timeframe === 'month' ? 'selected' : '' %>>Last 30 Days</option>
                    </select>
                </div>
            </header>

            <!-- Points Configuration -->
            <section class="card">
                <h2>Points Configuration</h2>
                <p style="color: var(--text-secondary); margin-bottom: 20px;">
                    Configure how points are calculated. By default, 1 character = 1 point.
                </p>
                
                <form id="pointsConfigForm">
                    <div class="form-group">
                        <label>Default Points per Character</label>
                        <input type="number" step="0.01" id="defaultMultiplier" 
                               value="<%= pointsConfig.default || 1 %>" 
                               style="max-width: 200px;">
                    </div>

                    <div class="form-group">
                        <label>Channel & Category Multipliers</label>
                        <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 10px;">
                            Set custom multipliers for specific channels or categories. Channel multipliers take precedence over category multipliers.
                        </p>
                        
                        <div id="channelsContainer" style="margin-top: 15px;">
                            <% if (channels && channels.length > 0) { %>
                                <% channels.forEach(category => { %>
                                    <div class="category-section" style="margin-bottom: 15px;">
                                        <div class="category-header" onclick="toggleCategory('<%= category.id %>')" 
                                             style="cursor: pointer; background-color: var(--surface-elevated); padding: 12px; border-radius: 6px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;">
                                            <div style="display: flex; align-items: center; gap: 10px;">
                                                <span class="category-arrow" id="arrow-<%= category.id %>">▼</span>
                                                <strong><%= category.name %></strong>
                                            </div>
                                            <div style="display: flex; align-items: center; gap: 10px;" onclick="event.stopPropagation();">
                                                <label style="margin: 0; font-size: 0.85rem;">Multiplier:</label>
                                                <input type="number" 
                                                       step="0.01" 
                                                       class="category-multiplier"
                                                       data-category-id="<%= category.id %>"
                                                       value="<%= (pointsConfig.categories && pointsConfig.categories[category.id]) || '' %>"
                                                       placeholder="Default"
                                                       style="width: 80px; padding: 6px; background-color: var(--surface); border: 1px solid var(--border); border-radius: 4px; color: var(--text-primary);">
                                            </div>
                                        </div>
                                        <div class="category-channels" id="channels-<%= category.id %>" style="padding-left: 30px;">
                                            <% category.channels.forEach(channel => { %>
                                                <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; margin-bottom: 3px; background-color: rgba(255,255,255,0.02); border-radius: 4px;">
                                                    <span># <%= channel.name %></span>
                                                    <div style="display: flex; align-items: center; gap: 10px;">
                                                        <label style="margin: 0; font-size: 0.85rem; color: var(--text-muted);">Multiplier:</label>
                                                        <input type="number" 
                                                               step="0.01" 
                                                               class="channel-multiplier"
                                                               data-channel-id="<%= channel.id %>"
                                                               value="<%= (pointsConfig.channels && pointsConfig.channels[channel.id]) || '' %>"
                                                               placeholder="Default"
                                                               style="width: 80px; padding: 6px; background-color: var(--surface); border: 1px solid var(--border); border-radius: 4px; color: var(--text-primary);">
                                                    </div>
                                                </div>
                                            <% }); %>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } %>
                            
                            <% if (uncategorizedChannels && uncategorizedChannels.length > 0) { %>
                                <div class="category-section" style="margin-bottom: 15px;">
                                    <div class="category-header" onclick="toggleCategory('uncategorized')" 
                                         style="cursor: pointer; background-color: var(--surface-elevated); padding: 12px; border-radius: 6px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;">
                                        <div style="display: flex; align-items: center; gap: 10px;">
                                            <span class="category-arrow" id="arrow-uncategorized">▼</span>
                                            <strong>Uncategorized Channels</strong>
                                        </div>
                                    </div>
                                    <div class="category-channels" id="channels-uncategorized" style="padding-left: 30px;">
                                        <% uncategorizedChannels.forEach(channel => { %>
                                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; margin-bottom: 3px; background-color: rgba(255,255,255,0.02); border-radius: 4px;">
                                                <span># <%= channel.name %></span>
                                                <div style="display: flex; align-items: center; gap: 10px;">
                                                    <label style="margin: 0; font-size: 0.85rem; color: var(--text-muted);">Multiplier:</label>
                                                    <input type="number" 
                                                           step="0.01" 
                                                           class="channel-multiplier"
                                                           data-channel-id="<%= channel.id %>"
                                                           value="<%= (pointsConfig.channels && pointsConfig.channels[channel.id]) || '' %>"
                                                           placeholder="Default"
                                                           style="width: 80px; padding: 6px; background-color: var(--surface); border: 1px solid var(--border); border-radius: 4px; color: var(--text-primary);">
                                                </div>
                                            </div>
                                        <% }); %>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <button type="button" onclick="savePointsConfig()" class="btn btn-success">Save Configuration</button>
                </form>
            </section>

            <!-- Top Users by Points -->
            <section class="card">
                <h2>Leaderboard - Top Users by Points</h2>
                <div style="background-color: var(--surface-elevated); padding: 15px; border-radius: 6px; margin-bottom: 20px;">
                    <p style="color: var(--text-secondary); margin: 0;">
                        <strong>Total Users:</strong> <%= userPoints.length %>
                    </p>
                </div>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Rank</th>
                            <th>Username</th>
                            <th>Total Points</th>
                            <th>Characters Sent</th>
                            <th>Points per Character</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% userPoints.slice(0, 100).forEach((user, index) => { %>
                        <tr>
                            <td>
                                <% if (index === 0) { %>
                                    🥇
                                <% } else if (index === 1) { %>
                                    🥈
                                <% } else if (index === 2) { %>
                                    🥉
                                <% } else { %>
                                    <%= index + 1 %>
                                <% } %>
                            </td>
                            <td><%= user.authorUsername %></td>
                            <td><strong><%= Math.round(user.totalPoints).toLocaleString() %></strong></td>
                            <td><%= user.totalCharacters.toLocaleString() %></td>
                            <td><%= user.totalCharacters > 0 ? (user.totalPoints / user.totalCharacters).toFixed(2) : '0.00' %></td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </section>

            <!-- Footer -->
            <footer class="footer">
                <p>Data from <%= new Date(startDate).toLocaleString() %> to <%= new Date(endDate).toLocaleString() %></p>
                <p class="muted">StatRekt Dashboard - Better alternative to Statbot</p>
            </footer>
        </main>
    </div>

    <script src="/js/dashboard.js"></script>
    <script>
        function changeTimeframe(value) {
            window.location.href = '/points?timeframe=' + value;
        }

        function toggleCategory(categoryId) {
            const channelsDiv = document.getElementById('channels-' + categoryId);
            const arrow = document.getElementById('arrow-' + categoryId);
            
            if (channelsDiv.style.display === 'none') {
                channelsDiv.style.display = 'block';
                arrow.textContent = '▼';
            } else {
                channelsDiv.style.display = 'none';
                arrow.textContent = '▶';
            }
        }

        async function savePointsConfig() {
            const defaultMultiplier = parseFloat(document.getElementById('defaultMultiplier').value);
            
            // Collect channel multipliers
            const channels = {};
            document.querySelectorAll('.channel-multiplier').forEach(input => {
                const channelId = input.dataset.channelId;
                const value = parseFloat(input.value);
                if (!isNaN(value) && value !== '') {
                    channels[channelId] = value;
                }
            });
            
            // Collect category multipliers
            const categories = {};
            document.querySelectorAll('.category-multiplier').forEach(input => {
                const categoryId = input.dataset.categoryId;
                const value = parseFloat(input.value);
                if (!isNaN(value) && value !== '') {
                    categories[categoryId] = value;
                }
            });
            
            const config = {
                default: defaultMultiplier,
                channels: channels,
                categories: categories
            };

            try {
                const response = await fetch('/api/points-config', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(config)
                });

                const result = await response.json();
                
                if (result.success) {
                    showToast('Points configuration saved successfully!', 'success');
                    setTimeout(() => {
                        window.location.reload();
                    }, 1500);
                } else {
                    showToast('Error saving configuration: ' + result.error, 'error');
                }
            } catch (error) {
                showToast('Error saving configuration: ' + error.message, 'error');
            }
        }
    </script>
</body>
</html>
