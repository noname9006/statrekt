<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= guildInfo.guild_name || 'Server' %> - Settings</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <!-- Navigation -->
        <nav class="sidebar">
            <div class="nav-header">
                <h2><%= guildInfo.guild_name || 'Server Analytics' %></h2>
                <p class="guild-id">ID: <%= guildInfo.guild_id || 'N/A' %></p>
            </div>
            <ul class="nav-menu">
                <li><a href="/">📊 Overview</a></li>
                <li><a href="/active-users">👥 Active Users</a></li>
                <li><a href="/messages">💬 Messages</a></li>
                <li><a href="/points">⭐ Points</a></li>
                <li class="active"><a href="/settings">⚙️ Settings</a></li>
            </ul>
        </nav>

        <!-- Main Content -->
        <main class="main-content">
            <header class="content-header">
                <h1>Settings</h1>
            </header>

            <!-- Role-Based Groups -->
            <section class="card">
                <h2>Role-Based Groups</h2>
                <p style="color: var(--text-secondary); margin-bottom: 20px;">
                    Create groups based on users' highest roles for better analytics segmentation.
                    For Ambassador groups, the system will automatically create sub-groups based on users' highest role within the group.
                </p>

                <div id="roleGroups">
                    <% (settings.roleGroups || []).forEach((group, index) => { %>
                    <div class="settings-card" style="margin-bottom: 15px;">
                        <div style="display: flex; justify-content: space-between; align-items: start;">
                            <div style="flex: 1;">
                                <h3><%= group.name %></h3>
                                <% if (group.isAmbassadorGroup) { %>
                                <div style="margin-top: 10px; padding: 10px; background-color: var(--surface); border-radius: 6px; border-left: 3px solid var(--primary-color);">
                                    <strong style="color: var(--primary-color);">Ambassador Group</strong>
                                    <p style="color: var(--text-secondary); font-size: 0.85rem; margin-top: 5px;">
                                        Auto-divides users into sub-groups based on their highest role from the selected roles:
                                    </p>
                                    <div style="margin-top: 8px;">
                                        <% (group.roles || []).forEach(roleId => { %>
                                            <% const role = roles.find(r => r.id === roleId); %>
                                            <% if (role) { %>
                                            <span class="role-tag" style="background-color: <%= role.color || '#99AAB5' %>; margin: 2px;">
                                                <%= role.name %>
                                            </span>
                                            <% } %>
                                        <% }); %>
                                    </div>
                                </div>
                                <% } else { %>
                                <p style="color: var(--text-secondary); font-size: 0.9rem;">
                                    Based on highest role: 
                                    <% const role = roles.find(r => r.id === group.roleId); %>
                                    <span class="role-tag" style="background-color: <%= role ? role.color : '#99AAB5' %>">
                                        <%= role ? role.name : 'Unknown Role' %>
                                    </span>
                                </p>
                                <% } %>
                            </div>
                            <button onclick="deleteGroup(<%= index %>)" class="btn btn-danger">
                                Delete Group
                            </button>
                        </div>
                    </div>
                    <% }); %>
                </div>

                <div style="margin-top: 20px; padding: 20px; background-color: var(--surface-elevated); border-radius: 8px;">
                    <h3 style="margin-bottom: 15px;">Create New Group</h3>
                    
                    <div class="form-group">
                        <label>
                            <input type="checkbox" id="isAmbassadorGroup" onchange="toggleAmbassadorMode()">
                            Ambassador Group (auto-divide by highest role)
                        </label>
                    </div>
                    
                    <div class="form-group">
                        <label>Group Name</label>
                        <input type="text" id="newGroupName" placeholder="e.g., Moderators, VIP Members, Ambassadors">
                    </div>
                    
                    <div id="standardGroupFields">
                        <div class="form-group">
                            <label>Base Role (highest role for this group)</label>
                            <select id="newGroupRole">
                                <option value="">-- Select Role --</option>
                                <% roles.forEach(role => { %>
                                <option value="<%= role.id %>"><%= role.name %></option>
                                <% }); %>
                            </select>
                        </div>
                    </div>
                    
                    <div id="ambassadorGroupFields" style="display: none;">
                        <div class="form-group">
                            <label>Select All Ambassador Roles (users will be grouped by their highest role)</label>
                            <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 10px;">
                                Select all roles that should be part of the ambassador group. The system will automatically create sub-groups for each role.
                            </p>
                            <div id="ambassadorRolesList" style="max-height: 300px; overflow-y: auto; padding: 10px; background-color: var(--surface); border-radius: 6px; border: 1px solid var(--border);">
                                <% roles.forEach(role => { %>
                                <div style="padding: 8px; margin: 4px 0; background-color: var(--surface-elevated); border-radius: 4px;">
                                    <label style="display: flex; align-items: center; cursor: pointer; margin: 0;">
                                        <input type="checkbox" class="ambassador-role-checkbox" value="<%= role.id %>" style="margin-right: 10px;">
                                        <span class="role-tag" style="background-color: <%= role.color || '#99AAB5' %>">
                                            <%= role.name %>
                                        </span>
                                    </label>
                                </div>
                                <% }); %>
                            </div>
                        </div>
                    </div>
                    
                    <button onclick="createGroup()" class="btn btn-success">Create Group</button>
                </div>
            </section>

            <!-- Excluded Roles for Stats -->
            <section class="card">
                <h2>Excluded Roles</h2>
                <p style="color: var(--text-secondary); margin-bottom: 20px;">
                    Users with these roles will be excluded from all statistics calculations.
                </p>

                <div id="excludedRolesDisplay" style="margin-bottom: 20px;">
                    <% (settings.excludedRoles || []).forEach(roleId => { %>
                        <% const role = roles.find(r => r.id === roleId); %>
                        <% if (role) { %>
                        <span class="role-tag" style="background-color: <%= role.color || '#99AAB5' %>">
                            <%= role.name %>
                            <button type="button" onclick="removeExcludedRole('<%= roleId %>')" 
                                    style="margin-left: 5px; background: none; border: none; color: inherit; cursor: pointer;">✕</button>
                        </span>
                        <% } %>
                    <% }); %>
                </div>

                <div class="form-group">
                    <label>Add Role to Exclude</label>
                    <select id="excludeRoleSelector" onchange="addExcludedRole(this.value)">
                        <option value="">-- Select Role --</option>
                        <% roles.forEach(role => { %>
                        <option value="<%= role.id %>"><%= role.name %></option>
                        <% }); %>
                    </select>
                </div>

                <button onclick="saveSettings()" class="btn btn-success">Save Settings</button>
            </section>

            <!-- Server Information -->
            <section class="card">
                <h2>Server Information</h2>
                <div class="settings-grid">
                    <div>
                        <strong>Server Name:</strong>
                        <p><%= guildInfo.guild_name || 'Unknown' %></p>
                    </div>
                    <div>
                        <strong>Server ID:</strong>
                        <p style="font-family: 'Courier New', monospace;"><%= guildInfo.guild_id || 'Unknown' %></p>
                    </div>
                    <div>
                        <strong>Database Created:</strong>
                        <p><%= guildInfo.creation_date ? new Date(guildInfo.creation_date).toLocaleString() : 'Unknown' %></p>
                    </div>
                    <div>
                        <strong>Total Roles:</strong>
                        <p><%= roles.length %></p>
                    </div>
                </div>
            </section>

            <!-- Available Roles -->
            <section class="card">
                <h2>Available Roles</h2>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Position</th>
                            <th>Name</th>
                            <th>Color</th>
                            <th>Hoisted</th>
                            <th>Role ID</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% roles.forEach(role => { %>
                        <tr>
                            <td><%= role.position %></td>
                            <td>
                                <span class="role-tag" style="background-color: <%= role.color || '#99AAB5' %>">
                                    <%= role.name %>
                                </span>
                            </td>
                            <td><%= role.color || 'Default' %></td>
                            <td><%= role.hoist ? 'Yes' : 'No' %></td>
                            <td style="font-family: 'Courier New', monospace; font-size: 0.85rem;"><%= role.id %></td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </section>

            <!-- Footer -->
            <footer class="footer">
                <p class="muted">StatRekt Dashboard - Better alternative to Statbot</p>
            </footer>
        </main>
    </div>

    <script src="/js/dashboard.js"></script>
    <script>
        let currentSettings = <%- JSON.stringify(settings) %>;
        
        function toggleAmbassadorMode() {
            const isAmbassador = document.getElementById('isAmbassadorGroup').checked;
            const standardFields = document.getElementById('standardGroupFields');
            const ambassadorFields = document.getElementById('ambassadorGroupFields');
            
            if (isAmbassador) {
                standardFields.style.display = 'none';
                ambassadorFields.style.display = 'block';
            } else {
                standardFields.style.display = 'block';
                ambassadorFields.style.display = 'none';
            }
        }
        
        function createGroup() {
            const name = document.getElementById('newGroupName').value;
            const isAmbassadorGroup = document.getElementById('isAmbassadorGroup').checked;
            
            if (!name) {
                showToast('Please provide a group name', 'error');
                return;
            }

            if (!currentSettings.roleGroups) {
                currentSettings.roleGroups = [];
            }

            if (isAmbassadorGroup) {
                // Get all selected ambassador roles
                const selectedRoles = Array.from(document.querySelectorAll('.ambassador-role-checkbox:checked'))
                    .map(cb => cb.value);
                
                if (selectedRoles.length === 0) {
                    showToast('Please select at least one role for the ambassador group', 'error');
                    return;
                }
                
                currentSettings.roleGroups.push({
                    name: name,
                    isAmbassadorGroup: true,
                    roles: selectedRoles
                });
            } else {
                const roleId = document.getElementById('newGroupRole').value;
                
                if (!roleId) {
                    showToast('Please select a role', 'error');
                    return;
                }
                
                currentSettings.roleGroups.push({
                    name: name,
                    roleId: roleId,
                    isAmbassadorGroup: false
                });
            }

            saveSettings().then(() => {
                window.location.reload();
            });
        }

        function deleteGroup(index) {
            if (confirm('Are you sure you want to delete this group?')) {
                currentSettings.roleGroups.splice(index, 1);
                saveSettings().then(() => {
                    window.location.reload();
                });
            }
        }

        function addExcludedRole(roleId) {
            if (!roleId) return;
            
            if (!currentSettings.excludedRoles) {
                currentSettings.excludedRoles = [];
            }
            
            if (!currentSettings.excludedRoles.includes(roleId)) {
                currentSettings.excludedRoles.push(roleId);
                document.getElementById('excludeRoleSelector').value = '';
                showToast('Role added to exclusion list. Click Save to apply.', 'success');
            }
        }

        function removeExcludedRole(roleId) {
            if (!currentSettings.excludedRoles) return;
            
            currentSettings.excludedRoles = currentSettings.excludedRoles.filter(id => id !== roleId);
            event.target.parentElement.remove();
            showToast('Role removed from exclusion list. Click Save to apply.', 'success');
        }

        async function saveSettings() {
            try {
                const response = await fetch('/api/settings', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(currentSettings)
                });

                const result = await response.json();
                
                if (result.success) {
                    showToast('Settings saved successfully!', 'success');
                    return Promise.resolve();
                } else {
                    showToast('Error saving settings: ' + result.error, 'error');
                    return Promise.reject(result.error);
                }
            } catch (error) {
                showToast('Error saving settings: ' + error.message, 'error');
                return Promise.reject(error);
            }
        }
    </script>
</body>
</html>
