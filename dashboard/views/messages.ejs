<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= guildInfo.guild_name || 'Server' %> - Messages Analytics</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2.0.1/dist/chartjs-plugin-zoom.min.js"></script>
</head>
<body>
    <div class="container">
        <!-- Navigation -->
        <nav class="sidebar">
            <div class="nav-header">
                <h2><%= guildInfo.guild_name || 'Server Analytics' %></h2>
                <p class="guild-id">ID: <%= guildInfo.guild_id || 'N/A' %></p>
            </div>
            <ul class="nav-menu">
                <li><a href="/">📊 Overview</a></li>
                <li><a href="/active-users">👥 Active Users</a></li>
                <li class="active"><a href="/messages">💬 Messages</a></li>
                <li><a href="/points">⭐ Points</a></li>
                <li><a href="/settings">⚙️ Settings</a></li>
            </ul>
        </nav>

        <!-- Main Content -->
        <main class="main-content">
            <header class="content-header">
                <h1>Message Analytics</h1>
                <div class="timeframe-selector">
                    <button id="preset-1d" class="preset-btn" onclick="setPresetRange(1)">1D</button>
                    <button id="preset-7d" class="preset-btn" onclick="setPresetRange(7)">7D</button>
                    <button id="preset-30d" class="preset-btn active" onclick="setPresetRange(30)">30D</button>
                    <button id="preset-90d" class="preset-btn" onclick="setPresetRange(90)">90D</button>
                    <button id="preset-all" class="preset-btn" onclick="setPresetRange('all')">ALL</button>
                </div>
            </header>

            <!-- Activity Over Time Chart -->
            <section class="card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                    <h2 style="margin: 0;">Message Activity Over Time</h2>
                    <div style="display: flex; gap: 10px;">
                        <select id="chartMetric" onchange="updateChart()" style="padding: 8px 12px; background-color: var(--surface-elevated); color: var(--text-primary); border: 1px solid var(--border); border-radius: 6px;">
                            <option value="messages">Messages</option>
                            <option value="users">Daily Active Users</option>
                            <option value="characters">Characters</option>
                        </select>
                        <select id="chartType" onchange="updateChart()" style="padding: 8px 12px; background-color: var(--surface-elevated); color: var(--text-primary); border: 1px solid var(--border); border-radius: 6px;">
                            <option value="bar">Bar Chart</option>
                            <option value="line">Line Chart</option>
                        </select>
                    </div>
                </div>
                <div class="chart-container" style="position: relative; height: 400px;">
                    <canvas id="activityChart"></canvas>
                </div>
                
                <!-- Timeline Slider -->
                <div class="timeline-container">
                    <div class="timeline-labels">
                        <span id="rangeStart">-</span>
                        <span id="rangeEnd">-</span>
                    </div>
                    <div class="timeline-slider">
                        <input type="range" id="rangeStartSlider" min="0" max="100" value="0" class="slider">
                        <input type="range" id="rangeEndSlider" min="0" max="100" value="100" class="slider">
                        <div class="slider-track">
                            <div class="slider-range" id="sliderRange"></div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Channel Activity -->
            <section class="card">
                <h2>Top Channels by Activity</h2>
                <table class="data-table sortable-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th class="sortable" data-sort="name">Channel</th>
                            <th class="sortable" data-sort="messages">Messages</th>
                            <th class="sortable" data-sort="users">Unique Users</th>
                            <th class="sortable" data-sort="characters">Total Characters</th>
                            <th class="sortable" data-sort="avg">Avg Characters/Message</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% channelActivity.forEach((channel, index) => { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td data-value="<%= channel.channelName || channel.channelId %>"><%= channel.channelName || channel.channelId %></td>
                            <td data-value="<%= channel.messageCount %>"><%= channel.messageCount.toLocaleString() %></td>
                            <td data-value="<%= channel.uniqueUsers %>"><%= channel.uniqueUsers %></td>
                            <td data-value="<%= channel.totalCharacters %>"><%= channel.totalCharacters.toLocaleString() %></td>
                            <td data-value="<%= channel.messageCount > 0 ? Math.round(channel.totalCharacters / channel.messageCount) : 0 %>"><%= channel.messageCount > 0 ? Math.round(channel.totalCharacters / channel.messageCount) : 0 %></td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </section>

            <!-- Category Activity -->
            <% if (categoryActivity && categoryActivity.length > 0) { %>
            <section class="card">
                <h2>Activity by Category</h2>
                <div class="chart-container">
                    <canvas id="categoryChart"></canvas>
                </div>
                <table class="data-table sortable-table" style="margin-top: 20px;">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th class="sortable" data-sort="name">Category</th>
                            <th class="sortable" data-sort="messages">Messages</th>
                            <th class="sortable" data-sort="users">Unique Users</th>
                            <th class="sortable" data-sort="characters">Total Characters</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% categoryActivity.forEach((category, index) => { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td data-value="<%= category.categoryName || 'Uncategorized' %>"><%= category.categoryName || 'Uncategorized' %></td>
                            <td data-value="<%= category.messageCount %>"><%= category.messageCount.toLocaleString() %></td>
                            <td data-value="<%= category.uniqueUsers %>"><%= category.uniqueUsers %></td>
                            <td data-value="<%= category.totalCharacters %>"><%= category.totalCharacters.toLocaleString() %></td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </section>
            <% } %>

            <!-- Top Users by Characters -->
            <section class="card">
                <h2>Top Users by Character Count</h2>
                <table class="data-table sortable-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th class="sortable" data-sort="name">Username</th>
                            <th class="sortable" data-sort="messages">Messages</th>
                            <th class="sortable" data-sort="characters">Total Characters</th>
                            <th class="sortable" data-sort="avg">Avg Characters/Message</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% topUsers.forEach((user, index) => { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td data-value="<%= user.authorUsername %>"><%= user.authorUsername %></td>
                            <td data-value="<%= user.messageCount %>"><%= user.messageCount.toLocaleString() %></td>
                            <td data-value="<%= user.totalCharacters %>"><%= user.totalCharacters.toLocaleString() %></td>
                            <td data-value="<%= Math.round(user.avgCharactersPerMessage || 0) %>"><%= Math.round(user.avgCharactersPerMessage || 0) %></td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </section>

            <!-- Footer -->
            <footer class="footer">
                <p>Drag the timeline slider to adjust the date range</p>
                <p class="muted">StatRekt Dashboard - Better alternative to Statbot</p>
            </footer>
        </main>
    </div>

    <script src="/js/dashboard.js"></script>
    <script>
        // Activity Over Time Chart
        const fullActivityData = <%- JSON.stringify(activityOverTime) %>;
        let currentActivityData = [...fullActivityData];
        let activityChart = null;
        
        function formatDateLabel(dateStr) {
            const date = new Date(dateStr);
            const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
            const dayOfWeek = dayNames[date.getDay()];
            const month = date.toLocaleDateString('en-US', { month: 'short' });
            const day = date.getDate();
            return `${dayOfWeek} ${month} ${day}`;
        }
        
        // Format date for display
        function formatDate(dateStr) {
            const date = new Date(dateStr);
            return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        }
        
        // Update date range display
        function updateRangeLabels(startIdx, endIdx) {
            if (fullActivityData.length === 0) return;
            
            const startDate = fullActivityData[startIdx].date;
            const endDate = fullActivityData[endIdx].date;
            
            document.getElementById('rangeStart').textContent = formatDate(startDate);
            document.getElementById('rangeEnd').textContent = formatDate(endDate);
        }
        
        // Update slider visual range
        function updateSliderRange() {
            const start = parseInt(document.getElementById('rangeStartSlider').value);
            const end = parseInt(document.getElementById('rangeEndSlider').value);
            
            const range = document.getElementById('sliderRange');
            range.style.left = start + '%';
            range.style.width = (end - start) + '%';
        }
        
        // Handle slider changes
        function handleSliderChange() {
            const startSlider = document.getElementById('rangeStartSlider');
            const endSlider = document.getElementById('rangeEndSlider');
            
            let start = parseInt(startSlider.value);
            let end = parseInt(endSlider.value);
            
            // Ensure start is always before end with boundary checks
            if (start >= end) {
                if (this.id === 'rangeStartSlider') {
                    start = Math.max(0, end - 1);
                    startSlider.value = start;
                } else {
                    end = Math.min(100, start + 1);
                    endSlider.value = end;
                }
            }
            
            // Additional boundary validation
            start = Math.max(0, Math.min(100, start));
            end = Math.max(0, Math.min(100, end));
            
            // Calculate indices based on percentage
            const dataLength = fullActivityData.length;
            
            // Handle edge case when there's only one data point
            if (dataLength <= 1) {
                currentActivityData = fullActivityData;
                updateChart();
                updateRangeLabels(0, 0);
                updateSliderRange();
                return;
            }
            
            const startIdx = Math.floor((start / 100) * (dataLength - 1));
            const endIdx = Math.floor((end / 100) * (dataLength - 1));
            
            // Update current data
            currentActivityData = fullActivityData.slice(startIdx, endIdx + 1);
            
            // Update chart and labels
            updateChart();
            updateRangeLabels(startIdx, endIdx);
            updateSliderRange();
            
            // Clear active preset buttons
            document.querySelectorAll('.preset-btn').forEach(btn => btn.classList.remove('active'));
        }
        
        // Set preset range (1d, 7d, 30d, etc.)
        function setPresetRange(days) {
            const dataLength = fullActivityData.length;
            
            // Handle edge case when there's only one data point
            if (dataLength <= 1) {
                currentActivityData = fullActivityData;
                updateChart();
                if (dataLength === 1) {
                    updateRangeLabels(0, 0);
                }
                updateSliderRange();
                return;
            }
            
            let startIdx, endIdx;
            
            if (days === 'all') {
                startIdx = 0;
                endIdx = dataLength - 1;
            } else {
                endIdx = dataLength - 1;
                startIdx = Math.max(0, dataLength - days);
            }
            
            // Update sliders (safe because dataLength > 1)
            const startPct = (startIdx / (dataLength - 1)) * 100;
            const endPct = (endIdx / (dataLength - 1)) * 100;
            
            document.getElementById('rangeStartSlider').value = startPct;
            document.getElementById('rangeEndSlider').value = endPct;
            
            // Update display
            currentActivityData = fullActivityData.slice(startIdx, endIdx + 1);
            updateChart();
            updateRangeLabels(startIdx, endIdx);
            updateSliderRange();
            
            // Update active button
            document.querySelectorAll('.preset-btn').forEach(btn => btn.classList.remove('active'));
            if (days === 'all') {
                document.getElementById('preset-all').classList.add('active');
            } else {
                document.getElementById(`preset-${days}d`).classList.add('active');
            }
        }
        
        function updateChart() {
            const metric = document.getElementById('chartMetric').value;
            const chartType = document.getElementById('chartType').value;
            
            if (activityChart) {
                activityChart.destroy();
            }
            
            const ctx = document.getElementById('activityChart');
            const labels = currentActivityData.map(d => formatDateLabel(d.date));
            let data, label;
            
            if (metric === 'messages') {
                data = currentActivityData.map(d => d.messageCount);
                label = 'Messages';
            } else if (metric === 'users') {
                data = currentActivityData.map(d => d.uniqueUsers);
                label = 'Daily Active Users';
            } else if (metric === 'characters') {
                data = currentActivityData.map(d => d.totalCharacters || 0);
                label = 'Characters';
            }
            
            activityChart = new Chart(ctx, {
                type: chartType,
                data: {
                    labels: labels,
                    datasets: [{
                        label: label,
                        data: data,
                        borderColor: '#5865F2',
                        backgroundColor: chartType === 'bar' ? '#5865F2' : 'rgba(88, 101, 242, 0.1)',
                        tension: 0.4,
                        fill: chartType === 'line',
                        pointRadius: 3,
                        pointHoverRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            display: true,
                            labels: {
                                color: '#ffffff'
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(47, 49, 54, 0.95)',
                            titleColor: '#ffffff',
                            bodyColor: '#b9bbbe',
                            borderColor: '#202225',
                            borderWidth: 1,
                            padding: 12,
                            displayColors: true
                        },
                        zoom: {
                            zoom: {
                                wheel: {
                                    enabled: true
                                },
                                pinch: {
                                    enabled: true
                                },
                                mode: 'x'
                            },
                            pan: {
                                enabled: true,
                                mode: 'x'
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: '#40444b',
                                borderColor: '#40444b'
                            },
                            ticks: {
                                color: '#b9bbbe',
                                precision: 0
                            }
                        },
                        x: {
                            grid: {
                                color: '#40444b',
                                borderColor: '#40444b'
                            },
                            ticks: {
                                color: '#b9bbbe',
                                maxRotation: 45,
                                minRotation: 45
                            }
                        }
                    }
                }
            });
        }
        
        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            // Set up slider event listeners
            document.getElementById('rangeStartSlider').addEventListener('input', handleSliderChange);
            document.getElementById('rangeEndSlider').addEventListener('input', handleSliderChange);
            
            // Initialize with default data (30 days)
            if (fullActivityData && fullActivityData.length > 0) {
                setPresetRange(30);
            } else {
                updateChart();
            }
        });

        // Category Chart
        const categoryData = <%- JSON.stringify(categoryActivity) %>;
        
        if (categoryData && categoryData.length > 0) {
            const ctx2 = document.getElementById('categoryChart');
            new Chart(ctx2, {
                type: 'bar',
                data: {
                    labels: categoryData.map(c => c.categoryName || 'Uncategorized'),
                    datasets: [{
                        label: 'Messages',
                        data: categoryData.map(c => c.messageCount),
                        backgroundColor: '#5865F2'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                color: '#b9bbbe'
                            },
                            grid: {
                                color: '#40444b'
                            }
                        },
                        x: {
                            ticks: {
                                color: '#b9bbbe'
                            },
                            grid: {
                                color: '#40444b'
                            }
                        }
                    }
                }
            });
        }

        // Table sorting functionality
        document.addEventListener('DOMContentLoaded', function() {
            const tables = document.querySelectorAll('.sortable-table');
            
            tables.forEach(table => {
                const headers = table.querySelectorAll('th.sortable');
                
                headers.forEach((header, index) => {
                    header.addEventListener('click', function() {
                        const tbody = table.querySelector('tbody');
                        const rows = Array.from(tbody.querySelectorAll('tr'));
                        const columnIndex = Array.from(header.parentElement.children).indexOf(header);
                        const sortType = header.dataset.sort;
                        const isAsc = header.classList.contains('asc');
                        
                        // Remove sort classes from all headers
                        headers.forEach(h => h.classList.remove('asc', 'desc'));
                        
                        // Add appropriate class to clicked header
                        if (isAsc) {
                            header.classList.add('desc');
                        } else {
                            header.classList.add('asc');
                        }
                        
                        // Sort rows
                        rows.sort((a, b) => {
                            const aCell = a.children[columnIndex];
                            const bCell = b.children[columnIndex];
                            const aVal = aCell.dataset.value || aCell.textContent;
                            const bVal = bCell.dataset.value || bCell.textContent;
                            
                            let comparison = 0;
                            if (sortType === 'name') {
                                comparison = aVal.localeCompare(bVal);
                            } else {
                                const aNum = parseFloat(aVal) || 0;
                                const bNum = parseFloat(bVal) || 0;
                                comparison = aNum - bNum;
                            }
                            
                            return isAsc ? -comparison : comparison;
                        });
                        
                        // Re-append rows in sorted order
                        rows.forEach((row, index) => {
                            tbody.appendChild(row);
                            // Update rank number
                            row.children[0].textContent = index + 1;
                        });
                    });
                });
            });
        });
    </script>
</body>
</html>
