<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= guildInfo.guild_name || 'Server' %> - Active Users</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2.0.1/dist/chartjs-plugin-zoom.min.js"></script>
</head>
<body>
    <div class="container">
        <!-- Navigation -->
        <nav class="sidebar">
            <div class="nav-header">
                <h2><%= guildInfo.guild_name || 'Server Analytics' %></h2>
                <p class="guild-id">ID: <%= guildInfo.guild_id || 'N/A' %></p>
            </div>
            <ul class="nav-menu">
                <li><a href="/">📊 Overview</a></li>
                <li class="active"><a href="/active-users">👥 Active Users</a></li>
                <li><a href="/messages">💬 Messages</a></li>
                <li><a href="/points">⭐ Points</a></li>
                <li><a href="/settings">⚙️ Settings</a></li>
            </ul>
        </nav>

        <!-- Main Content -->
        <main class="main-content">
            <header class="content-header">
                <h1>Active Users Timeline</h1>
                <div class="timeframe-selector">
                    <button id="preset-1d" class="preset-btn" onclick="setPresetRange(1)">1D</button>
                    <button id="preset-7d" class="preset-btn" onclick="setPresetRange(7)">7D</button>
                    <button id="preset-30d" class="preset-btn active" onclick="setPresetRange(30)">30D</button>
                    <button id="preset-90d" class="preset-btn" onclick="setPresetRange(90)">90D</button>
                    <button id="preset-all" class="preset-btn" onclick="setPresetRange('all')">ALL</button>
                </div>
            </header>
            
            <!-- Metric Selector -->
            <div style="text-align: center; margin: 20px 0;">
                <div class="timeframe-selector">
                    <button id="metric-dau" class="preset-btn active" onclick="setMetric('dau')">DAU</button>
                    <button id="metric-wau" class="preset-btn" onclick="setMetric('wau')">WAU</button>
                    <button id="metric-2wau" class="preset-btn" onclick="setMetric('2wau')">2WAU</button>
                    <button id="metric-mau" class="preset-btn" onclick="setMetric('mau')">MAU</button>
                </div>
            </div>

            <!-- Key Metrics Summary -->
            <section class="metrics-grid">
                <div class="metric-card">
                    <h3 id="avgLabel">Average</h3>
                    <div class="metric-value" id="avgDau">-</div>
                    <div class="metric-label">in selected period</div>
                </div>
                <div class="metric-card">
                    <h3 id="peakLabel">Peak</h3>
                    <div class="metric-value" id="peakDau">-</div>
                    <div class="metric-label" id="peakDate">-</div>
                </div>
                <div class="metric-card">
                    <h3 id="lowestLabel">Lowest</h3>
                    <div class="metric-value" id="lowestDau">-</div>
                    <div class="metric-label" id="lowestDate">-</div>
                </div>
                <div class="metric-card">
                    <h3>Total Days</h3>
                    <div class="metric-value" id="totalDays">-</div>
                    <div class="metric-label">in selected period</div>
                </div>
            </section>

            <!-- DAU Chart with Timeline -->
            <section class="card">
                <h2>Daily Active Users Over Time</h2>
                <div class="chart-container" style="position: relative; height: 400px;">
                    <canvas id="dauChart"></canvas>
                </div>
                
                <!-- Timeline Slider -->
                <div class="timeline-container">
                    <div class="timeline-labels">
                        <span id="rangeStart">-</span>
                        <span id="rangeEnd">-</span>
                    </div>
                    <div class="timeline-slider">
                        <input type="range" id="rangeStartSlider" min="0" max="100" value="0" class="slider">
                        <input type="range" id="rangeEndSlider" min="0" max="100" value="100" class="slider">
                        <div class="slider-track">
                            <div class="slider-range" id="sliderRange"></div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Recent Activity Table -->
            <section class="card" style="margin-top: 30px;">
                <h2>Recent Activity</h2>
                
                <!-- Filters -->
                <div style="margin-bottom: 20px;">
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 15px;">
                        <!-- User Filter -->
                        <div>
                            <label style="display: block; margin-bottom: 5px; color: #b9bbbe;">Filter by User</label>
                            <input type="text" id="userFilter" placeholder="Search by username or ID..." 
                                   style="width: 100%; padding: 8px; background: #40444b; border: 1px solid #202225; color: #dcddde; border-radius: 4px;">
                        </div>
                        
                        <!-- Level Filter -->
                        <div>
                            <label style="display: block; margin-bottom: 5px; color: #b9bbbe;">Filter by Level</label>
                            <select id="levelFilter" style="width: 100%; padding: 8px; background: #40444b; border: 1px solid #202225; color: #dcddde; border-radius: 4px;">
                                <option value="">All Levels</option>
                                <% if (roleGroups && roleGroups.length > 0) { %>
                                    <% roleGroups.forEach(group => { %>
                                        <option value="<%= group.name %>"><%= group.name %></option>
                                    <% }); %>
                                <% } %>
                            </select>
                        </div>
                        
                        <!-- Channel Filter Type -->
                        <div>
                            <label style="display: block; margin-bottom: 5px; color: #b9bbbe;">Channel Filter Type</label>
                            <select id="channelFilterType" style="width: 100%; padding: 8px; background: #40444b; border: 1px solid #202225; color: #dcddde; border-radius: 4px;">
                                <option value="all">All Channels</option>
                                <option value="whitelist">Whitelist (only selected)</option>
                                <option value="blacklist">Blacklist (exclude selected)</option>
                            </select>
                        </div>
                        
                        <!-- Channel Selection -->
                        <div>
                            <label style="display: block; margin-bottom: 5px; color: #b9bbbe;">Select Channels</label>
                            <select id="channelFilter" multiple size="1" style="width: 100%; padding: 8px; background: #40444b; border: 1px solid #202225; color: #dcddde; border-radius: 4px;">
                                <% if (channels && channels.length > 0) { %>
                                    <% channels.forEach(channel => { %>
                                        <option value="<%= channel.id %>"><%= channel.name %></option>
                                    <% }); %>
                                <% } %>
                            </select>
                            <small style="color: #72767d;">Hold Ctrl/Cmd to select multiple</small>
                        </div>
                    </div>
                    
                    <div style="margin-top: 15px;">
                        <button onclick="applyFilters()" style="padding: 8px 20px; background: #5865F2; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 500;">Apply Filters</button>
                        <button onclick="clearFilters()" style="padding: 8px 20px; background: #40444b; color: #dcddde; border: none; border-radius: 4px; cursor: pointer; margin-left: 10px;">Clear Filters</button>
                    </div>
                </div>
                
                <!-- Activity Table -->
                <div style="overflow-x: auto;">
                    <table class="data-table sortable-table" id="activityTable">
                        <thead>
                            <tr>
                                <th class="sortable" data-sort="username">Username</th>
                                <th class="sortable" data-sort="days">Days Since Last Message</th>
                                <th class="sortable" data-sort="lastMessage">Last Message Date</th>
                                <th class="sortable" data-sort="messages">Total Messages</th>
                                <th>Level</th>
                            </tr>
                        </thead>
                        <tbody id="activityTableBody">
                            <!-- Will be populated by JavaScript -->
                        </tbody>
                    </table>
                </div>
                
                <div style="margin-top: 15px; color: #b9bbbe;">
                    Showing <span id="activityCount">0</span> users
                </div>
            </section>

            <!-- Footer -->
            <footer class="footer">
                <p>Drag the timeline slider to adjust the date range</p>
                <p class="muted">StatRekt Dashboard - Better alternative to Statbot</p>
            </footer>
        </main>
    </div>

    <script>
        // Initialize data from server
        const fullDataDAU = <%- JSON.stringify(dauTimeline) %>;
        const fullDataWAU = <%- JSON.stringify(wauTimeline) %>;
        const fullData2WAU = <%- JSON.stringify(twoWauTimeline) %>;
        const fullDataMAU = <%- JSON.stringify(mauTimeline) %>;
        
        let currentMetric = 'dau';
        let fullData = fullDataDAU;
        let currentData = [...fullData];
        
        let chart = null;
        
        // Function to aggregate data by weeks or months
        function aggregateData(data, metric) {
            if (metric === 'dau') {
                return data; // No aggregation for DAU
            }
            
            if (data.length === 0) return [];
            
            const aggregated = [];
            const buckets = {};
            
            data.forEach(point => {
                const date = new Date(point.date);
                let key;
                
                if (metric === 'wau' || metric === '2wau') {
                    // Aggregate by week (starting Monday)
                    const weekStart = new Date(date);
                    const day = weekStart.getDay();
                    const diff = (day === 0 ? -6 : 1) - day; // Adjust to Monday
                    weekStart.setDate(weekStart.getDate() + diff);
                    key = weekStart.toISOString().split('T')[0];
                } else if (metric === 'mau') {
                    // Aggregate by month
                    const year = date.getFullYear();
                    const month = String(date.getMonth() + 1).padStart(2, '0');
                    key = `${year}-${month}-01`;
                }
                
                if (!buckets[key]) {
                    buckets[key] = {
                        date: key,
                        values: [],
                        count: 0
                    };
                }
                
                const value = getMetricValue(point);
                buckets[key].values.push(value);
                buckets[key].count++;
            });
            
            // Convert buckets to array and calculate averages
            Object.keys(buckets).sort().forEach(key => {
                const bucket = buckets[key];
                const avg = Math.round(bucket.values.reduce((a, b) => a + b, 0) / bucket.values.length);
                
                aggregated.push({
                    date: key,
                    dau: metric === 'dau' ? avg : 0,
                    wau: metric === 'wau' ? avg : 0,
                    twoWau: metric === '2wau' ? avg : 0,
                    mau: metric === 'mau' ? avg : 0
                });
            });
            
            return aggregated;
        }
        
        // Function to set the metric
        function setMetric(metric) {
            currentMetric = metric;
            
            // Switch the data source and aggregate if needed
            let rawData;
            switch(metric) {
                case 'dau':
                    rawData = fullDataDAU;
                    break;
                case 'wau':
                    rawData = fullDataWAU;
                    break;
                case '2wau':
                    rawData = fullData2WAU;
                    break;
                case 'mau':
                    rawData = fullDataMAU;
                    break;
            }
            
            // Aggregate data for weekly/monthly views
            fullData = aggregateData(rawData, metric);
            
            // Update metric labels
            const shortMetric = metric.toUpperCase();
            document.getElementById('avgLabel').textContent = `Average ${shortMetric}`;
            document.getElementById('peakLabel').textContent = `Peak ${shortMetric}`;
            document.getElementById('lowestLabel').textContent = `Lowest ${shortMetric}`;
            
            // Update active button
            document.querySelectorAll('[id^="metric-"]').forEach(btn => btn.classList.remove('active'));
            document.getElementById(`metric-${metric}`).classList.add('active');
            
            // Re-apply the current range filter
            const activePreset = document.querySelector('.preset-btn.active');
            if (activePreset) {
                const presetValue = activePreset.id.replace('preset-', '').replace('d', '');
                setPresetRange(presetValue === 'all' ? 'all' : parseInt(presetValue));
            } else {
                currentData = [...fullData];
                initChart(currentData);
            }
        }
        
        // Helper functions for metric handling
        function getMetricValue(dataPoint) {
            switch(currentMetric) {
                case 'dau':
                    return dataPoint.dau || 0;
                case 'wau':
                    return dataPoint.wau || 0;
                case '2wau':
                    return dataPoint.twoWau || 0;
                case 'mau':
                    return dataPoint.mau || 0;
                default:
                    return dataPoint.dau || 0;
            }
        }
        
        function getMetricLabel() {
            switch(currentMetric) {
                case 'dau':
                    return 'Daily Active Users';
                case 'wau':
                    return 'Weekly Active Users';
                case '2wau':
                    return 'Bi-Weekly Active Users';
                case 'mau':
                    return 'Monthly Active Users';
                default:
                    return 'Active Users';
            }
        }
        
        // Get the step size for x-axis ticks based on metric
        function getTickStepSize() {
            switch(currentMetric) {
                case 'dau':
                    return 1; // Daily resolution
                case 'wau':
                    return 7; // Weekly resolution
                case '2wau':
                    return 14; // 2-week resolution
                case 'mau':
                    return 30; // Monthly resolution
                default:
                    return 1;
            }
        }
        
        // Configure x-axis ticks callback to show only relevant dates
        function configureXAxisTicks(data) {
            const stepSize = getTickStepSize();
            return {
                color: '#b9bbbe',
                maxRotation: 45,
                minRotation: 45,
                callback: function(value, index, ticks) {
                    // Show every nth tick based on step size
                    if (index % stepSize === 0 && data[index]) {
                        return formatChartLabel(data[index].date);
                    }
                    return '';
                }
            };
        }
        
        // Initialize the chart
        function initChart(data) {
            const ctx = document.getElementById('dauChart');
            
            // Check if Chart.js is loaded
            if (typeof Chart === 'undefined') {
                console.warn('Chart.js not loaded, skipping chart initialization');
                // Still update metrics even if chart can't render
                updateMetrics(data);
                return;
            }
            
            if (!ctx) {
                console.error('Chart canvas not found');
                return;
            }
            
            if (chart) {
                chart.destroy();
            }
            
            chart = new Chart(ctx.getContext('2d'), {
                type: 'line',
                data: {
                    labels: data.map(d => d.date),
                    datasets: [{
                        label: getMetricLabel(),
                        data: data.map(d => getMetricValue(d)),
                        borderColor: '#5865F2',
                        backgroundColor: 'rgba(88, 101, 242, 0.1)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.1,
                        pointRadius: 3,
                        pointHoverRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            display: true,
                            labels: {
                                color: '#b9bbbe'
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(47, 49, 54, 0.95)',
                            titleColor: '#ffffff',
                            bodyColor: '#b9bbbe',
                            borderColor: '#202225',
                            borderWidth: 1,
                            padding: 12,
                            displayColors: true,
                            callbacks: {
                                title: function(context) {
                                    if (context[0] && context[0].label) {
                                        return formatDate(context[0].label);
                                    }
                                    return '';
                                }
                            }
                        },
                        zoom: {
                            zoom: {
                                wheel: {
                                    enabled: true
                                },
                                pinch: {
                                    enabled: true
                                },
                                mode: 'x'
                            },
                            pan: {
                                enabled: true,
                                mode: 'x'
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: {
                                color: '#40444b',
                                borderColor: '#40444b'
                            },
                            ticks: configureXAxisTicks(data)
                        },
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: '#40444b',
                                borderColor: '#40444b'
                            },
                            ticks: {
                                color: '#b9bbbe',
                                precision: 0
                            }
                        }
                    }
                }
            });
            
            updateMetrics(data);
        }
        
        // Update metrics based on current data
        function updateMetrics(data) {
            if (data.length === 0) {
                document.getElementById('avgDau').textContent = '0';
                document.getElementById('peakDau').textContent = '0';
                document.getElementById('lowestDau').textContent = '0';
                document.getElementById('totalDays').textContent = '0';
                document.getElementById('peakDate').textContent = '-';
                document.getElementById('lowestDate').textContent = '-';
                return;
            }
            
            const values = data.map(d => getMetricValue(d));
            const avg = Math.round(values.reduce((a, b) => a + b, 0) / values.length);
            const max = Math.max(...values);
            const min = Math.min(...values);
            
            const peakDay = data.find(d => getMetricValue(d) === max);
            const lowestDay = data.find(d => getMetricValue(d) === min);
            
            document.getElementById('avgDau').textContent = avg.toLocaleString();
            document.getElementById('peakDau').textContent = max.toLocaleString();
            document.getElementById('lowestDau').textContent = min.toLocaleString();
            document.getElementById('totalDays').textContent = data.length.toLocaleString();
            document.getElementById('peakDate').textContent = peakDay ? formatDate(peakDay.date) : '-';
            document.getElementById('lowestDate').textContent = lowestDay ? formatDate(lowestDay.date) : '-';
        }
        
        // Format date for display based on current metric
        function formatDate(dateStr) {
            const date = new Date(dateStr);
            
            if (currentMetric === 'wau' || currentMetric === '2wau') {
                // For weekly metrics, show week range
                const weekEnd = new Date(date);
                weekEnd.setDate(weekEnd.getDate() + 6);
                const startStr = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
                const endStr = weekEnd.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                return `${startStr} - ${endStr}`;
            } else if (currentMetric === 'mau') {
                // For monthly metrics, show month and year
                return date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
            } else {
                // For daily metrics, show normal date
                return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
            }
        }
        
        // Format date for chart labels (shorter format)
        function formatChartLabel(dateStr) {
            const date = new Date(dateStr);
            
            if (currentMetric === 'wau' || currentMetric === '2wau') {
                // For weekly metrics, show week starting date
                return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
            } else if (currentMetric === 'mau') {
                // For monthly metrics, show month abbreviation and year
                return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
            } else {
                // For daily metrics, show date
                return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
            }
        }
        
        // Update date range display
        function updateRangeLabels(startIdx, endIdx) {
            if (fullData.length === 0) return;
            
            const startDate = fullData[startIdx].date;
            const endDate = fullData[endIdx].date;
            
            document.getElementById('rangeStart').textContent = formatDate(startDate);
            document.getElementById('rangeEnd').textContent = formatDate(endDate);
        }
        
        // Update slider visual range
        function updateSliderRange() {
            const start = parseInt(document.getElementById('rangeStartSlider').value);
            const end = parseInt(document.getElementById('rangeEndSlider').value);
            
            const range = document.getElementById('sliderRange');
            range.style.left = start + '%';
            range.style.width = (end - start) + '%';
        }
        
        // Handle slider changes
        function handleSliderChange(event) {
            const startSlider = document.getElementById('rangeStartSlider');
            const endSlider = document.getElementById('rangeEndSlider');
            
            let start = parseInt(startSlider.value);
            let end = parseInt(endSlider.value);
            
            // Ensure start is always before end with boundary checks
            if (start >= end) {
                if (event && event.target.id === 'rangeStartSlider') {
                    start = Math.max(0, end - 1);
                    startSlider.value = start;
                } else {
                    end = Math.min(100, start + 1);
                    endSlider.value = end;
                }
            }
            
            // Additional boundary validation
            start = Math.max(0, Math.min(100, start));
            end = Math.max(0, Math.min(100, end));
            
            // Calculate indices based on percentage
            const dataLength = fullData.length;
            
            // Handle edge case when there's only one data point
            if (dataLength <= 1) {
                currentData = fullData;
                initChart(currentData);
                updateRangeLabels(0, 0);
                updateSliderRange();
                return;
            }
            
            const startIdx = Math.floor((start / 100) * (dataLength - 1));
            const endIdx = Math.floor((end / 100) * (dataLength - 1));
            
            // Update current data
            currentData = fullData.slice(startIdx, endIdx + 1);
            
            // Update chart and labels
            initChart(currentData);
            updateRangeLabels(startIdx, endIdx);
            updateSliderRange();
            
            // Clear active preset buttons
            document.querySelectorAll('.preset-btn').forEach(btn => btn.classList.remove('active'));
        }
        
        // Set preset range (1d, 7d, 30d, etc.)
        function setPresetRange(days) {
            const dataLength = fullData.length;
            
            // Handle edge case when there's only one data point
            if (dataLength <= 1) {
                currentData = fullData;
                initChart(currentData);
                if (dataLength === 1) {
                    updateRangeLabels(0, 0);
                }
                updateSliderRange();
                return;
            }
            
            let startIdx, endIdx;
            
            if (days === 'all') {
                startIdx = 0;
                endIdx = dataLength - 1;
            } else {
                endIdx = dataLength - 1;
                startIdx = Math.max(0, dataLength - days);
            }
            
            // Update sliders (safe because dataLength > 1)
            const startPct = (startIdx / (dataLength - 1)) * 100;
            const endPct = (endIdx / (dataLength - 1)) * 100;
            
            document.getElementById('rangeStartSlider').value = startPct;
            document.getElementById('rangeEndSlider').value = endPct;
            
            // Update display
            currentData = fullData.slice(startIdx, endIdx + 1);
            initChart(currentData);
            updateRangeLabels(startIdx, endIdx);
            updateSliderRange();
            
            // Update active button
            document.querySelectorAll('.preset-btn').forEach(btn => btn.classList.remove('active'));
            if (days === 'all') {
                document.getElementById('preset-all').classList.add('active');
            } else {
                document.getElementById(`preset-${days}d`).classList.add('active');
            }
        }
        
        // Recent Activity Table functionality
        const recentActivityData = <%- JSON.stringify(recentActivity) %>;
        const userRolesData = <%- JSON.stringify(userRoles) %>;
        const roleGroupsData = <%- JSON.stringify(roleGroups) %>;
        
        let filteredActivityData = [...recentActivityData];
        let currentSort = { column: 'days', direction: 'asc' };
        
        // Get user's highest role level
        function getUserLevel(userId) {
            const roles = userRolesData[userId] || [];
            
            // Find the highest position role that belongs to a role group
            for (const group of roleGroupsData) {
                for (const role of roles) {
                    if (group.roles && group.roles.includes(role.roleId)) {
                        return group.name;
                    }
                }
            }
            
            return 'No Level';
        }
        
        // Populate activity table
        function populateActivityTable(data) {
            const tbody = document.getElementById('activityTableBody');
            tbody.innerHTML = '';
            
            data.forEach(user => {
                const row = document.createElement('tr');
                const level = getUserLevel(user.userId);
                const lastMessageDate = new Date(user.lastMessageTimestamp);
                
                row.innerHTML = `
                    <td data-value="${user.username}">${user.username || user.userId}</td>
                    <td data-value="${user.daysSinceLastMessage}">${user.daysSinceLastMessage}</td>
                    <td data-value="${user.lastMessageTimestamp}">${lastMessageDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</td>
                    <td data-value="${user.totalMessages}">${user.totalMessages.toLocaleString()}</td>
                    <td data-value="${level}">${level}</td>
                `;
                
                tbody.appendChild(row);
            });
            
            document.getElementById('activityCount').textContent = data.length;
        }
        
        // Apply filters
        function applyFilters() {
            const userFilter = document.getElementById('userFilter').value.toLowerCase();
            const levelFilter = document.getElementById('levelFilter').value;
            const channelFilterType = document.getElementById('channelFilterType').value;
            const channelFilter = Array.from(document.getElementById('channelFilter').selectedOptions).map(opt => opt.value);
            
            // Start with all data
            filteredActivityData = [...recentActivityData];
            
            // Apply user filter
            if (userFilter) {
                filteredActivityData = filteredActivityData.filter(user => {
                    const username = (user.username || '').toLowerCase();
                    const userId = (user.userId || '').toLowerCase();
                    return username.includes(userFilter) || userId.includes(userFilter);
                });
            }
            
            // Apply level filter
            if (levelFilter) {
                filteredActivityData = filteredActivityData.filter(user => {
                    return getUserLevel(user.userId) === levelFilter;
                });
            }
            
            // Note: Channel filtering would require refetching data from server with channel filters
            // For now, we'll show a message if channel filters are selected
            if (channelFilterType !== 'all' && channelFilter.length > 0) {
                console.log('Channel filtering requires server-side filtering');
                // This would need to be implemented with an API call
            }
            
            // Apply current sort
            sortActivityTable(currentSort.column, currentSort.direction);
        }
        
        // Clear filters
        function clearFilters() {
            document.getElementById('userFilter').value = '';
            document.getElementById('levelFilter').value = '';
            document.getElementById('channelFilterType').value = 'all';
            document.getElementById('channelFilter').selectedIndex = -1;
            
            filteredActivityData = [...recentActivityData];
            sortActivityTable(currentSort.column, currentSort.direction);
        }
        
        // Sort activity table
        function sortActivityTable(column, direction) {
            currentSort = { column, direction };
            
            filteredActivityData.sort((a, b) => {
                let aVal, bVal;
                
                switch(column) {
                    case 'username':
                        aVal = (a.username || a.userId).toLowerCase();
                        bVal = (b.username || b.userId).toLowerCase();
                        break;
                    case 'days':
                        aVal = a.daysSinceLastMessage;
                        bVal = b.daysSinceLastMessage;
                        break;
                    case 'lastMessage':
                        aVal = a.lastMessageTimestamp;
                        bVal = b.lastMessageTimestamp;
                        break;
                    case 'messages':
                        aVal = a.totalMessages;
                        bVal = b.totalMessages;
                        break;
                    default:
                        return 0;
                }
                
                if (direction === 'asc') {
                    return aVal > bVal ? 1 : -1;
                } else {
                    return aVal < bVal ? 1 : -1;
                }
            });
            
            populateActivityTable(filteredActivityData);
        }
        
        // Add click handlers for sortable headers
        function setupTableSorting() {
            const headers = document.querySelectorAll('#activityTable th.sortable');
            headers.forEach(header => {
                header.style.cursor = 'pointer';
                header.addEventListener('click', function() {
                    const column = this.dataset.sort;
                    const direction = currentSort.column === column && currentSort.direction === 'asc' ? 'desc' : 'asc';
                    
                    // Update header indicators
                    headers.forEach(h => h.classList.remove('sort-asc', 'sort-desc'));
                    this.classList.add(direction === 'asc' ? 'sort-asc' : 'sort-desc');
                    
                    sortActivityTable(column, direction);
                });
            });
        }
        
        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            // Set up slider event listeners
            document.getElementById('rangeStartSlider').addEventListener('input', handleSliderChange);
            document.getElementById('rangeEndSlider').addEventListener('input', handleSliderChange);
            
            // Initialize with default data (30 days)
            if (fullData.length > 0) {
                setPresetRange(30);
            } else {
                initChart([]);
            }
            
            // Initialize activity table
            populateActivityTable(recentActivityData);
            setupTableSorting();
        });
    </script>
</body>
</html>
