<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= guildInfo.guild_name || 'Server' %> - Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body>
    <div class="container">
        <!-- Navigation -->
        <nav class="sidebar">
            <div class="nav-header">
                <h2><%= guildInfo.guild_name || 'Server Analytics' %></h2>
                <p class="guild-id">ID: <%= guildInfo.guild_id || 'N/A' %></p>
            </div>
            <ul class="nav-menu">
                <li class="active"><a href="/">📊 Overview</a></li>
                <li><a href="/messages">💬 Messages</a></li>
                <li><a href="/points">⭐ Points</a></li>
                <li><a href="/settings">⚙️ Settings</a></li>
            </ul>
        </nav>

        <!-- Main Content -->
        <main class="main-content">
            <header class="content-header">
                <h1>Dashboard Overview</h1>
                <div class="timeframe-selector">
                    <select id="timeframe" onchange="changeTimeframe(this.value)">
                        <option value="24h" <%= timeframe === '24h' ? 'selected' : '' %>>Last 24 Hours</option>
                        <option value="yesterday" <%= timeframe === 'yesterday' ? 'selected' : '' %>>Yesterday</option>
                        <option value="week" <%= timeframe === 'week' ? 'selected' : '' %>>Last 7 Days</option>
                        <option value="lastweek" <%= timeframe === 'lastweek' ? 'selected' : '' %>>Last Week</option>
                        <option value="month" <%= timeframe === 'month' ? 'selected' : '' %>>Last 30 Days</option>
                        <option value="lastmonth" <%= timeframe === 'lastmonth' ? 'selected' : '' %>>Last Month</option>
                    </select>
                    
                    <% if (compareWith !== undefined) { %>
                    <select id="compare" onchange="changeComparison(this.value)">
                        <option value="">No Comparison</option>
                        <option value="prev_24h" <%= compareWith === 'prev_24h' ? 'selected' : '' %>>Previous 24h</option>
                        <option value="prev_week" <%= compareWith === 'prev_week' ? 'selected' : '' %>>Previous Week</option>
                        <option value="prev_month" <%= compareWith === 'prev_month' ? 'selected' : '' %>>Previous Month</option>
                    </select>
                    <% } %>
                </div>
            </header>

            <!-- Key Metrics -->
            <% if (timeframeInfo && timeframeInfo.label) { %>
            <div style="background-color: var(--surface-elevated); padding: 15px; border-radius: 6px; margin-bottom: 20px;">
                <p style="color: var(--text-primary); margin: 0; font-size: 1.1em;">
                    <strong><%= timeframeInfo.label %></strong>
                </p>
            </div>
            <% } %>
            
            <section class="metrics-grid">
                <% if (timeframeInfo.showDAU) { %>
                <div class="metric-card">
                    <h3><%= timeframeInfo.dauLabel || 'Daily Active Users' %></h3>
                    <div class="metric-value"><%= dau.displayValue !== undefined ? dau.displayValue : dau.count %></div>
                    <% if (period1Stats) { %>
                    <div class="metric-comparison">
                        <% const change = (overallStats.totalMessages || 0) - (period1Stats.totalMessages || 0); %>
                        <% const pctChange = period1Stats.totalMessages > 0 ? ((change / period1Stats.totalMessages) * 100).toFixed(1) : 0; %>
                        <span class="<%= change >= 0 ? 'positive' : 'negative' %>">
                            <%= change >= 0 ? '▲' : '▼' %> <%= Math.abs(change) %> (<%= Math.abs(pctChange) %>%)
                        </span>
                    </div>
                    <% } %>
                </div>
                <% } %>

                <% if (timeframeInfo.showWAU) { %>
                <div class="metric-card">
                    <h3><%= timeframeInfo.wauLabel || 'Weekly Active Users' %></h3>
                    <div class="metric-value"><%= wau.displayValue !== undefined ? wau.displayValue : wau.count %></div>
                </div>
                <% } %>

                <% if (timeframeInfo.showMAU) { %>
                <div class="metric-card">
                    <h3><%= timeframeInfo.mauLabel || 'Monthly Active Users' %></h3>
                    <div class="metric-value"><%= mau.count %></div>
                </div>
                <% } %>

                <div class="metric-card">
                    <h3>Total Messages</h3>
                    <div class="metric-value"><%= overallStats.totalMessages.toLocaleString() %></div>
                    <% if (period1Stats) { %>
                    <div class="metric-comparison">
                        <% const msgChange = (overallStats.totalMessages || 0) - (period1Stats.totalMessages || 0); %>
                        <% const msgPctChange = period1Stats.totalMessages > 0 ? ((msgChange / period1Stats.totalMessages) * 100).toFixed(1) : 0; %>
                        <span class="<%= msgChange >= 0 ? 'positive' : 'negative' %>">
                            <%= msgChange >= 0 ? '▲' : '▼' %> <%= Math.abs(msgChange).toLocaleString() %> (<%= Math.abs(msgPctChange) %>%)
                        </span>
                    </div>
                    <% } %>
                </div>

                <div class="metric-card">
                    <h3>Active Channels</h3>
                    <div class="metric-value"><%= overallStats.activeChannels %></div>
                    <% if (period1Stats) { %>
                    <div class="metric-comparison">
                        <% const chanChange = (overallStats.activeChannels || 0) - (period1Stats.activeChannels || 0); %>
                        <span class="<%= chanChange >= 0 ? 'positive' : 'negative' %>">
                            <%= chanChange >= 0 ? '▲' : '▼' %> <%= Math.abs(chanChange) %>
                        </span>
                    </div>
                    <% } %>
                </div>

                <div class="metric-card">
                    <h3>Total Characters</h3>
                    <div class="metric-value"><%= overallStats.totalCharacters.toLocaleString() %></div>
                    <% if (period1Stats) { %>
                    <div class="metric-comparison">
                        <% const charChange = (overallStats.totalCharacters || 0) - (period1Stats.totalCharacters || 0); %>
                        <% const charPctChange = period1Stats.totalCharacters > 0 ? ((charChange / period1Stats.totalCharacters) * 100).toFixed(1) : 0; %>
                        <span class="<%= charChange >= 0 ? 'positive' : 'negative' %>">
                            <%= charChange >= 0 ? '▲' : '▼' %> <%= Math.abs(charChange).toLocaleString() %> (<%= Math.abs(charPctChange) %>%)
                        </span>
                    </div>
                    <% } %>
                </div>

                <div class="metric-card">
                    <h3>Avg Message Length</h3>
                    <div class="metric-value"><%= Math.round(overallStats.avgMessageLength || 0) %></div>
                    <div class="metric-label">characters</div>
                </div>

                <div class="metric-card">
                    <h3>Messages with Reactions</h3>
                    <div class="metric-value"><%= reactionsStats.messagesWithReactions.toLocaleString() %></div>
                    <div class="metric-label">
                        <%= reactionsStats.totalMessages > 0 ? 
                            ((reactionsStats.messagesWithReactions / reactionsStats.totalMessages * 100).toFixed(1)) : 0 %>% of messages
                    </div>
                </div>

                <div class="metric-card">
                    <h3>Total Reactions</h3>
                    <div class="metric-value"><%= reactionsStats.totalReactions.toLocaleString() %></div>
                </div>
            </section>

            <!-- Top Reactions -->
            <% if (reactionsStats.topEmojis && reactionsStats.topEmojis.length > 0) { %>
            <section class="card">
                <h2>Top Reactions</h2>
                <div class="reaction-list">
                    <% reactionsStats.topEmojis.forEach(emoji => { %>
                    <div class="reaction-item">
                        <span class="emoji"><%= emoji.emoji %></span>
                        <span class="count"><%= emoji.count.toLocaleString() %></span>
                    </div>
                    <% }); %>
                </div>
            </section>
            <% } %>

            <!-- Top Users -->
            <section class="card">
                <h2>Top Users by Messages</h2>
                <table class="data-table sortable-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th class="sortable" data-sort="name">Username</th>
                            <th class="sortable" data-sort="messages">Messages</th>
                            <th class="sortable" data-sort="characters">Characters</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% topUsers.slice(0, 15).forEach((user, index) => { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td data-value="<%= user.authorUsername %>"><%= user.authorUsername %></td>
                            <td data-value="<%= user.messageCount %>"><%= user.messageCount.toLocaleString() %></td>
                            <td data-value="<%= user.totalCharacters %>"><%= user.totalCharacters.toLocaleString() %></td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </section>

            <!-- Top Channels -->
            <section class="card">
                <h2>Top Channels by Activity</h2>
                <table class="data-table sortable-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th class="sortable" data-sort="name">Channel</th>
                            <th class="sortable" data-sort="messages">Messages</th>
                            <th class="sortable" data-sort="users">Unique Users</th>
                            <th class="sortable" data-sort="characters">Characters</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% channelActivity.slice(0, 15).forEach((channel, index) => { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td data-value="<%= channel.channelName || channel.channelId %>"><%= channel.channelName || channel.channelId %></td>
                            <td data-value="<%= channel.messageCount %>"><%= channel.messageCount.toLocaleString() %></td>
                            <td data-value="<%= channel.uniqueUsers %>"><%= channel.uniqueUsers %></td>
                            <td data-value="<%= channel.totalCharacters %>"><%= channel.totalCharacters.toLocaleString() %></td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </section>

            <!-- Top Categories -->
            <% if (categoryActivity && categoryActivity.length > 0) { %>
            <section class="card">
                <h2>Top Categories by Activity</h2>
                <table class="data-table sortable-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th class="sortable" data-sort="name">Category</th>
                            <th class="sortable" data-sort="messages">Messages</th>
                            <th class="sortable" data-sort="users">Unique Users</th>
                            <th class="sortable" data-sort="characters">Characters</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% categoryActivity.forEach((category, index) => { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td data-value="<%= category.categoryName || 'Uncategorized' %>"><%= category.categoryName || 'Uncategorized' %></td>
                            <td data-value="<%= category.messageCount %>"><%= category.messageCount.toLocaleString() %></td>
                            <td data-value="<%= category.uniqueUsers %>"><%= category.uniqueUsers %></td>
                            <td data-value="<%= category.totalCharacters %>"><%= category.totalCharacters.toLocaleString() %></td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </section>
            <% } %>

            <!-- Footer -->
            <footer class="footer">
                <p>Data from <%= new Date(startDate).toLocaleString() %> to <%= new Date(endDate).toLocaleString() %></p>
                <p class="muted">StatRekt Dashboard - Better alternative to Statbot</p>
            </footer>
        </main>
    </div>

    <script src="/js/dashboard.js"></script>
    <script>
        function changeTimeframe(value) {
            const compareEl = document.getElementById('compare');
            let url = '/?timeframe=' + value;
            if (compareEl && compareEl.value) {
                url += '&compare=' + compareEl.value;
            }
            window.location.href = url;
        }

        function changeComparison(value) {
            const timeframe = document.getElementById('timeframe').value;
            let url = '/?timeframe=' + timeframe;
            if (value) {
                url += '&compare=' + value;
            }
            window.location.href = url;
        }

        // Table sorting functionality
        document.addEventListener('DOMContentLoaded', function() {
            const tables = document.querySelectorAll('.sortable-table');
            
            tables.forEach(table => {
                const headers = table.querySelectorAll('th.sortable');
                
                headers.forEach((header, index) => {
                    header.addEventListener('click', function() {
                        const tbody = table.querySelector('tbody');
                        const rows = Array.from(tbody.querySelectorAll('tr'));
                        const columnIndex = Array.from(header.parentElement.children).indexOf(header);
                        const sortType = header.dataset.sort;
                        const isAsc = header.classList.contains('asc');
                        
                        // Remove sort classes from all headers
                        headers.forEach(h => h.classList.remove('asc', 'desc'));
                        
                        // Add appropriate class to clicked header
                        if (isAsc) {
                            header.classList.add('desc');
                        } else {
                            header.classList.add('asc');
                        }
                        
                        // Sort rows
                        rows.sort((a, b) => {
                            const aCell = a.children[columnIndex];
                            const bCell = b.children[columnIndex];
                            const aVal = aCell.dataset.value || aCell.textContent;
                            const bVal = bCell.dataset.value || bCell.textContent;
                            
                            let comparison = 0;
                            if (sortType === 'name') {
                                comparison = aVal.localeCompare(bVal);
                            } else {
                                const aNum = parseFloat(aVal) || 0;
                                const bNum = parseFloat(bVal) || 0;
                                comparison = aNum - bNum;
                            }
                            
                            return isAsc ? -comparison : comparison;
                        });
                        
                        // Re-append rows in sorted order
                        rows.forEach((row, index) => {
                            tbody.appendChild(row);
                            // Update rank number
                            row.children[0].textContent = index + 1;
                        });
                    });
                });
            });
        });
    </script>
</body>
</html>
